# ============================================
# 🔐 Configuration globale (variables d'environnement)
# ============================================
# Dupliquer ce fichier en .env et remplir avec vos vraies valeurs
# IMPORTANT : Ne JAMAIS commit .env en Git!

# API Google Fact-Check
GOOGLE_FACT_CHECK_API_KEY=votre_api_key_ici

# Selenium (scraping)
SELENIUM_REMOTE_URL=http://selenium-chrome:4444/wd/hub

# ============================================
# Base de données Postgres
# ============================================
DB_TYPE=postgres
DB_HOST=postgres
DB_SCHEMA=checkit
DB_LOGIN=writer
DB_PASSWORD=votre_password_writer_ici
DB_PORT=5432

# ============================================
# Rôles Postgres (créés via setup_db.py)
# ============================================
DB_ADMIN_PASSWORD=votre_password_admin_ici
DB_WRITER_PASSWORD=votre_password_writer_ici
DB_READER_PASSWORD=votre_password_reader_ici
